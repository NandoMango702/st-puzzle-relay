<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:fitsSystemWindows="false"
	tools:context=".GameChooser">
	<!-- NB: the root deliberately does NOT fitSystemWindows. The bottom bar's
	     inset listener in GameChooser is the single source of truth for the
	     navigation-bar inset (padding + grown height, per the edge-to-edge
	     pattern); letting the root consume insets too applied the inset twice
	     and left a nav-bar-sized dead gap below the icons. The top AppBarLayout
	     keeps its own fitsSystemWindows for the status bar. -->

	<com.google.android.material.appbar.AppBarLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:fitsSystemWindows="true">

		<com.google.android.material.appbar.MaterialToolbar
			android:id="@+id/toolbar"
			android:layout_width="match_parent"
			android:layout_height="?attr/actionBarSize" />

	</com.google.android.material.appbar.AppBarLayout>

	<ScrollView xmlns:supportLib="http://schemas.android.com/apk/res-auto"
				android:id="@+id/scrollView"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				app:layout_behavior="@string/appbar_scrolling_view_behavior">
		<androidx.gridlayout.widget.GridLayout
			android:id="@+id/table"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingTop="2dip"
			android:paddingBottom="2dip"
			android:stretchColumns="*"
			android:shrinkColumns="*"
			android:layout_gravity="center_horizontal"
			android:animateLayoutChanges="true"
			tools:ignore="UnusedAttribute">
			<TextView android:id="@+id/games_starred"
				android:text="@string/games_starred"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:textAppearance="?android:attr/textAppearanceMedium"
				android:background="@color/chooser_section_background"
				android:paddingLeft="4dip"
				android:paddingRight="4dip"
				supportLib:layout_column="0"
				supportLib:layout_row="0"/>
			<TextView android:id="@+id/games_others"
				android:text="@string/games_others"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:textAppearance="?android:attr/textAppearanceMedium"
				android:background="@color/chooser_section_background"
				android:paddingLeft="4dip"
				android:paddingRight="4dip"
				supportLib:layout_column="0"
				supportLib:layout_row="1"/>
		</androidx.gridlayout.widget.GridLayout>
	</ScrollView>

	<!-- Bottom action bar: the chooser's action buttons live here for thumb
	     reachability. Its bottom padding is set from the system-bar insets in
	     GameChooser so it always sits above the Android navigation bar. -->
	<com.google.android.material.appbar.MaterialToolbar
		android:id="@+id/bottomBar"
		android:layout_width="match_parent"
		android:layout_height="?attr/actionBarSize"
		android:layout_gravity="bottom"
		android:background="@color/chooser_section_background"
		android:elevation="8dp" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
